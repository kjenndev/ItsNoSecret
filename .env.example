# Copy to .env only for a new local setup, then supply real credentials.
# Never commit populated environment files or use these placeholders.
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/its_no_secret"
# Generate independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=5000
# Only needed when explicitly seeding NEW users in a disposable development DB.
# Use distinct password-manager-generated passwords; existing users are unchanged.
SEED_ADMIN_PASSWORD=
SEED_TECH_PASSWORD=
